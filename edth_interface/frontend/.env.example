# Copiază în .env (fișier local, exclus din Git și din dist/) și repornește `npm run dev`.
# Cheie TomTom cu acces la Traffic API (Orbis v2): https://developer.tomtom.com/user/me/apps
TOMTOM_API_KEY=

# Serverul C2 (TCP, mesaje JSON). Fără BACKEND_PORT interfața rămâne pe datele demonstrative.
# Serverul Qt alege acum un port liber la fiecare pornire: folosiți un port fix sau copiați-l din jurnalul lui.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=
